{
  "name": "ship-kit-migrate",
  "version": "1.0.0",
  "description": "Deterministic, fixture-tested jscodeshift codemods that migrate a Next.js app from NextAuth or Clerk to Better Auth. An assist, not a one-click migrator.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20.9" },
  "bin": { "ship-kit-migrate": "migrate/cli.mjs" },
  "files": ["migrate", "README.md", "LICENSE"],
  "scripts": {
    "migrate": "node ./migrate/cli.mjs",
    "test": "vitest run migrate/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "better-auth",
    "nextauth",
    "clerk",
    "codemod",
    "jscodeshift",
    "nextjs",
    "migration",
    "authentication"
  ],
  "homepage": "https://betterauth.app",
  "repository": { "type": "git", "url": "https://github.com/authlayerdev/ship-kit-migrate.git" },
  "dependencies": { "jscodeshift": "17.3.0" },
  "devDependencies": {
    "@types/jscodeshift": "17.3.0",
    "@types/node": "^20",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
